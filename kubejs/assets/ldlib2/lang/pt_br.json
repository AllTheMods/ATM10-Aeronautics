    "ldlib2.configuration.title": "Configurações de %s",
    "ldlib2.configuration.font": "Renderização de Texto",
    "ldlib2.configuration.font.tooltip": "Como o LDLib desenha o texto em suas próprias interfaces. Não afeta telas vanilla nem outros mods.",
    "ldlib2.configuration.font.fontRenderMode": "Renderizador",
    "ldlib2.configuration.font.fontRenderMode.tooltip": "Vanilla entrega o texto ao Minecraft intocado. SDF amostra um atlas escalável único: suave em qualquer tamanho ou ângulo, um pouco difuso de perto. Raster redesenha cada glifo no tamanho em que aparece: o mais nítido, mas um atlas separado por tamanho. Auto usa raster para texto parado na grade de pixels e SDF para qualquer coisa escalada, girada ou animada.",
    "ldlib2.configuration.font.fontAtlasSize": "Tamanho da Página do Atlas",
    "ldlib2.configuration.font.fontAtlasSize.tooltip": "Comprimento da aresta em pixels de uma página do atlas de glifos. Páginas maiores cabem mais glifos, então uma tela cheia de texto custa menos chamadas de desenho.",
    "ldlib2.configuration.font.sdfEmSize": "Resolução do Campo de Distância",
    "ldlib2.configuration.font.sdfEmSize.tooltip": "Altura em pixels em que um em é rasterizado ao construir o campo de distância. Maior mantém cantos agudos mais nítidos em textos grandes, ao custo de espaço no atlas.",
    "ldlib2.configuration.font.sdfSharpness": "Nitidez das Bordas",
    "ldlib2.configuration.font.sdfSharpness.tooltip": "Multiplicador da largura da borda com suavização. Acima de 1 fica mais nítido, abaixo de 1 fica mais suave.",
    "ldlib2.configuration.font.sdfWeight": "Peso do Traço",
    "ldlib2.configuration.font.sdfWeight.tooltip": "Engrossa ou afina os traços por uma fração de pixel. Aumente levemente se textos pequenos parecerem finos demais.",
    "ldlib2.configuration.font.fontRasterMaxSize": "Limite de Tamanho do Raster",
    "ldlib2.configuration.font.fontRasterMaxSize.tooltip": "Maior tamanho de texto, em pixels do dispositivo, que será rasterizado no tamanho desenhado. Qualquer coisa maior usa o campo de distância. O tamanho de um elemento de texto equivale ao tamanho da fonte vezes a escala da GUI.",
    "ldlib2.configuration.font.fontRasterEvictSeconds": "Tempo Limite do Tamanho Raster",
    "ldlib2.configuration.font.fontRasterEvictSeconds.tooltip": "Segundos que um tamanho rasterizado pode ficar sem ser desenhado antes de seu atlas ser liberado. Evita que percorrer muitos tamanhos de zoom use memória sem limite.",
    "ldlib2.configuration.font.textLayoutCache": "Cache de Layout de Texto",
    "ldlib2.configuration.font.textLayoutCache.tooltip": "Reutiliza onde cada glifo vai entre quadros em vez de recalcular a cada quadro. Desative apenas se o texto renderizar com estilo errado.",
    "ldlib2.configuration.font.fontRenderMode.vanilla": "Vanilla",
    "ldlib2.configuration.font.fontRenderMode.sdf": "Campo de Distância",
    "ldlib2.configuration.font.fontRenderMode.raster": "Rasterizado",
    "ldlib2.configuration.font.fontRenderMode.auto": "Automático"
